{
	"schemaVersion": 1,
	"id": "usus_item_model_delay",
	"version": "1.0.1",
	"name": "Usu's Item Model Delay",
	"description": "Lets resource packs delay Minecraft item-model property transitions across conditional, range-dispatch, and select properties.",
	"authors": [
		"UsujioTarako"
	],
	"license": "CC0-1.0",
	"icon": "assets/usus_item_model_delay/icon.png",
